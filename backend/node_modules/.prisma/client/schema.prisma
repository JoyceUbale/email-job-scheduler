generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  name              String
  avatarUrl         String?
  googleId          String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  senderConfigs     SenderConfig[]
  slackIntegrations SlackIntegration?
  emailJobs         EmailJob[]
}

/// Stores per-sender SMTP credentials and rate-limit configuration.
model SenderConfig {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderEmail String     @unique
  senderName  String
  smtpHost    String
  smtpPort    Int
  smtpUser    String
  smtpPass    String
  /// Maximum emails this sender can send per hour.
  hourlyLimit Int        @default(30)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  emailJobs   EmailJob[]
}

/// Stores Slack OAuth tokens and webhook URLs for notifications.
model SlackIntegration {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String
  webhookUrl  String?
  channel     String?
  isConnected Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Represents a single email scheduled through the system.
model EmailJob {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderConfigId String
  senderConfig   SenderConfig   @relation(fields: [senderConfigId], references: [id], onDelete: Cascade)
  recipient      String
  recipientName  String?
  subject        String
  body           String
  /// Current status: pending, sent, or failed
  status         EmailJobStatus @default(pending)
  /// When the email is scheduled to be sent
  scheduledFor   DateTime
  /// When the email was actually sent
  sentAt         DateTime?
  /// Error message if the email failed
  errorMessage   String?
  /// Delay between consecutive emails in seconds (campaign-level)
  delaySeconds   Int            @default(60)
  /// Hourly limit per sender (campaign-level, copied from SenderConfig)
  hourlyLimit    Int            @default(30)
  /// Number of leads in this campaign
  leadCount      Int            @default(1)
  /// Whether a Slack notification was sent for this job
  slackNotified  Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([status])
  @@index([senderConfigId])
  @@index([scheduledFor])
}

enum EmailJobStatus {
  pending
  sent
  failed
}
