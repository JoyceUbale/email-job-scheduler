# ─── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database (PostgreSQL) ───────────────────────────────
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox

# ─── Redis ───────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Elasticsearch ───────────────────────────────────────
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ─── Worker ──────────────────────────────────────────────
WORKER_CONCURRENCY=5

# ─── SMTP (Ethereal Email — test SMTP service) ──────────
# These are generated at https://ethereal.email — leave blank to auto-create
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
